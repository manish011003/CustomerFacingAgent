# Copy to backend/.env — that is the file load_dotenv() reads.
# A live key makes the LLM the conversational orchestrator (tool calls).
# With no key the agent still runs on deterministic tools + template replies,
# and that path is labelled fallback — it is not pretending to be a live LLM.

# ---------------------------------------------------------------------------
# Provider. Leave unset for "auto": the first key found wins, preferring the
# free tiers (gemini, then groq, then xai, then openai). Set to "none" to
# force the deterministic fallback even when a key is present.

# ---------------------------------------------------------------------------
# Provider. Leave unset for "auto": the first key found wins, preferring the
# free tiers (gemini, then groq, then xai, then openai). Set to "none" to
# force the deterministic path even when a key is present.
#
# Worth pinning rather than leaving to "auto": a Gemini key wins the auto race,
# and once its daily quota is spent every model in that family refuses at once,
# so each turn spends seconds collecting refusals before falling back. Groq
# answered the same traffic in under a second. Run tools/probe_models.py to see
# which chain your keys can actually reach.
# ---------------------------------------------------------------------------
# LLM_PROVIDER=groq

# Free tier. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Free tier. https://console.groq.com/keys — keys start with gsk_
GROQ_API_KEY=

# Credit-based, no free tier. https://console.x.ai — keys start with xai-
# XAI_API_KEY=

# OPENAI_API_KEY=

# Override the provider's default model (gemini-2.5-flash, openai/gpt-oss-20b,
# grok-4.3, gpt-4o-mini respectively). Whatever you set here only leads the
# fallback chain below; the rest of the family stays behind it.
# LLM_MODEL=
# LLM_BASE_URL=

# ---------------------------------------------------------------------------
# Model fallback. A free tier runs out of quota per model, not per project, so
# an unavailable model costs the next one in the family rather than the whole
# LLM path. On Gemini the default chain is 2.5-flash, then 2.5-flash-lite,
# then the gemini-flash-lite-latest and gemini-flash-latest aliases, which
# are last because they outlive the retirement of any pinned version.
# At most three are tried per call, so a dead family cannot stack up timeouts
# in front of the passenger, and a model that refuses stops leading the chain
# for the cooldown below. Set to "none" to try exactly one model.
# ---------------------------------------------------------------------------
# LLM_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-flash-latest
# LLM_MODEL_COOLDOWN_SECONDS=300

# ---------------------------------------------------------------------------
# Spend ceilings. Breaching any of these degrades that turn to the template
# reply and logs the reason at /api/llm/health. None of them can change a
# policy decision, because the policy engine never calls a model.
# ---------------------------------------------------------------------------
# LLM_MAX_TOKENS_EXTRACT=200
# LLM_MAX_TOKENS_RESPOND=220
# LLM_MAX_TOKENS_AGENT=1024

# Gemini 2.5 thinks by default and charges the thinking against max_tokens,
# which leaves almost nothing for the answer and truncates it mid-word. The
# agent sends reasoning_effort=none to Gemini for that reason. Only Gemini
# accepts the parameter. Set this to override, or to empty to send nothing.
# LLM_REASONING_EFFORT=none
# LLM_TIMEOUT_SECONDS=15
# LLM_MAX_CALLS_PER_SESSION=24
# LLM_MAX_CALLS_PER_PROCESS=500
# LLM_DAILY_BUDGET_USD=1.0

# Operations staff login. Passenger accounts cannot open the dashboard.
# Override in backend/.env if you do not want the prototype defaults.
# STAFF_EMAIL=ops@aeroresolve.local
# STAFF_PASSWORD=AeroOps2026!

# Frustration classifier. A signal, not an authority: these gates decide what
# is stored and when a supervisor is fetched, never what policy allows.
# Below KB_AUTO_STORE_THRESHOLD the observation is still logged, tagged
# low_confidence, and excluded from the primary analytics buckets.
# KB_AUTO_STORE_THRESHOLD=0.75
# FRUSTRATION_ESCALATION_THRESHOLD=0.85

ELASTICSEARCH_URL=http://localhost:9200
NEXT_PUBLIC_API_URL=http://localhost:8000
