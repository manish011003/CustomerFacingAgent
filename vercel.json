{
  "services": {
    "web": {
      "root": "frontend/",
      "framework": "nextjs"
    },
    "ops": {
      "root": "frontend-manager/",
      "framework": "nextjs"
    },
    "api": {
      "root": "backend/",
      "framework": "fastapi",
      "entrypoint": "vercel_app:app",
      "functions": {
        "vercel_app.py": {
          "maxDuration": 60
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": { "service": "api" } },
    { "source": "/ops", "destination": { "service": "ops" } },
    { "source": "/ops/:path*", "destination": { "service": "ops" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
